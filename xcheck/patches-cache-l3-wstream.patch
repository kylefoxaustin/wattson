diff --git a/contrib/plugins/cache.c b/contrib/plugins/cache.c
index 0a5349f131e..b017981d3d0 100644
--- a/contrib/plugins/cache.c
+++ b/contrib/plugins/cache.c
@@ -101,6 +101,23 @@ static Cache **l1_dcaches, **l1_icaches;
 static bool use_l2;
 static Cache **l2_ucaches;
 
+/* wattson: optional 3rd level (the DSU L3 on the i.MX95 path) and a
+ * write-streaming model (the A55 stops allocating on detected store streams;
+ * modelling it splits DRAM WRITE traffic from read refills, which is also how
+ * the silicon PMUs count -- l3d_cache_refill sees only the read side). */
+static bool use_l3;
+static Cache **l3_ucaches;
+static GMutex *l3_ucache_locks;
+static int l3_cachesize = 512 * 1024;
+static int l3_assoc = 16;
+static int l3_blksize = 64;
+static bool use_wstream;
+static uint64_t *ws_prev_line;   /* per-core streak detector state */
+static int *ws_streak;
+static uint64_t *ws_last_wline;  /* last line already counted as a DRAM write */
+static uint64_t wstream_stores;       /* stores handled in streaming mode */
+static uint64_t wstream_dram_writes;  /* ...that missed every level = DRAM writes */
+
 static GMutex *l1_dcache_locks;
 static GMutex *l1_icache_locks;
 static GMutex *l2_ucache_locks;
@@ -385,6 +402,29 @@ static bool access_cache(Cache *cache, uint64_t addr)
     return false;
 }
 
+/* probe only: count a hit and refresh metadata, but never allocate on miss */
+static bool probe_cache(Cache *cache, uint64_t addr)
+{
+    int hit_blk = in_cache(cache, addr);
+    if (hit_blk != -1) {
+        if (update_hit) {
+            update_hit(cache, extract_set(cache, addr), hit_blk);
+        }
+        return true;
+    }
+    return false;
+}
+
+static void l3_refill_access(int cache_idx, uint64_t addr)
+{
+    g_mutex_lock(&l3_ucache_locks[cache_idx]);
+    if (!access_cache(l3_ucaches[cache_idx], addr)) {
+        l3_ucaches[cache_idx]->misses++;
+    }
+    l3_ucaches[cache_idx]->accesses++;
+    g_mutex_unlock(&l3_ucache_locks[cache_idx]);
+}
+
 static void vcpu_mem_access(unsigned int vcpu_index, qemu_plugin_meminfo_t info,
                             uint64_t vaddr, void *userdata)
 {
@@ -402,6 +442,52 @@ static void vcpu_mem_access(unsigned int vcpu_index, qemu_plugin_meminfo_t info,
     effective_addr = hwaddr ? qemu_plugin_hwaddr_phys_addr(hwaddr) : vaddr;
     cache_idx = vcpu_index % cores;
 
+    if (use_wstream && qemu_plugin_mem_is_store(info)) {
+        uint64_t line = effective_addr >> l1_dcaches[cache_idx]->blksize_shift;
+        bool streaming;
+        g_mutex_lock(&l1_dcache_locks[cache_idx]);
+        if (!probe_cache(l1_dcaches[cache_idx], effective_addr)) {
+            /* store missed L1: advance the stream detector. Same-line misses
+             * keep the streak alive (in streaming mode the line is never
+             * filled, so every store to it misses); next-line misses advance
+             * it; anything else breaks it. */
+            if (line == ws_prev_line[cache_idx] + 1) {
+                ws_streak[cache_idx]++;
+                ws_prev_line[cache_idx] = line;
+            } else if (line != ws_prev_line[cache_idx]) {
+                ws_streak[cache_idx] = 1;
+                ws_prev_line[cache_idx] = line;
+            }
+            streaming = ws_streak[cache_idx] >= 4;
+            if (streaming) {
+                /* no-allocate write: probe outer levels, never fill */
+                l1_dcaches[cache_idx]->accesses++;
+                g_mutex_unlock(&l1_dcache_locks[cache_idx]);
+                __atomic_fetch_add(&wstream_stores, 1, __ATOMIC_SEQ_CST);
+                bool outer_hit = false;
+                if (use_l2) {
+                    g_mutex_lock(&l2_ucache_locks[cache_idx]);
+                    outer_hit = probe_cache(l2_ucaches[cache_idx], effective_addr);
+                    g_mutex_unlock(&l2_ucache_locks[cache_idx]);
+                }
+                if (!outer_hit && use_l3) {
+                    g_mutex_lock(&l3_ucache_locks[cache_idx]);
+                    outer_hit = probe_cache(l3_ucaches[cache_idx], effective_addr);
+                    g_mutex_unlock(&l3_ucache_locks[cache_idx]);
+                }
+                if (!outer_hit && line != ws_last_wline[cache_idx]) {
+                    /* one DRAM write burst per line, not per store */
+                    __atomic_fetch_add(&wstream_dram_writes, 1, __ATOMIC_SEQ_CST);
+                    ws_last_wline[cache_idx] = line;
+                }
+                return;
+            }
+        }
+        g_mutex_unlock(&l1_dcache_locks[cache_idx]);
+        /* non-streaming store: fall through to the normal allocating path
+         * (the probe above may double-count one L1 access; negligible) */
+    }
+
     g_mutex_lock(&l1_dcache_locks[cache_idx]);
     hit_in_l1 = access_cache(l1_dcaches[cache_idx], effective_addr);
     if (!hit_in_l1) {
@@ -417,14 +503,20 @@ static void vcpu_mem_access(unsigned int vcpu_index, qemu_plugin_meminfo_t info,
         return;
     }
 
+    bool hit_in_l2;
     g_mutex_lock(&l2_ucache_locks[cache_idx]);
-    if (!access_cache(l2_ucaches[cache_idx], effective_addr)) {
+    hit_in_l2 = access_cache(l2_ucaches[cache_idx], effective_addr);
+    if (!hit_in_l2) {
         insn = userdata;
         __atomic_fetch_add(&insn->l2_misses, 1, __ATOMIC_SEQ_CST);
         l2_ucaches[cache_idx]->misses++;
     }
     l2_ucaches[cache_idx]->accesses++;
     g_mutex_unlock(&l2_ucache_locks[cache_idx]);
+
+    if (!hit_in_l2 && use_l3) {
+        l3_refill_access(cache_idx, effective_addr);
+    }
 }
 
 static void vcpu_insn_exec(unsigned int vcpu_index, void *userdata)
@@ -452,14 +544,20 @@ static void vcpu_insn_exec(unsigned int vcpu_index, void *userdata)
         return;
     }
 
+    bool hit_in_l2;
     g_mutex_lock(&l2_ucache_locks[cache_idx]);
-    if (!access_cache(l2_ucaches[cache_idx], insn_addr)) {
+    hit_in_l2 = access_cache(l2_ucaches[cache_idx], insn_addr);
+    if (!hit_in_l2) {
         insn = userdata;
         __atomic_fetch_add(&insn->l2_misses, 1, __ATOMIC_SEQ_CST);
         l2_ucaches[cache_idx]->misses++;
     }
     l2_ucaches[cache_idx]->accesses++;
     g_mutex_unlock(&l2_ucache_locks[cache_idx]);
+
+    if (!hit_in_l2 && use_l3) {
+        l3_refill_access(cache_idx, insn_addr);
+    }
 }
 
 static void vcpu_tb_trans(struct qemu_plugin_tb *tb, void *userdata)
@@ -634,6 +732,18 @@ static void log_stats(void)
                 l2_cache ? l2_mem_accesses : 0, l2_cache ? l2_misses : 0);
     }
 
+    if (use_l3) {
+        uint64_t l3a = 0, l3m = 0;
+        for (i = 0; i < cores; i++) {
+            l3a += l3_ucaches[i]->accesses;
+            l3m += l3_ucaches[i]->misses;
+        }
+        g_string_append_printf(rep,
+            "wattson: l3_accesses=%" PRIu64 " l3_misses=%" PRIu64
+            " wstream_stores=%" PRIu64 " wstream_dram_writes=%" PRIu64 "\n",
+            l3a, l3m, wstream_stores, wstream_dram_writes);
+    }
+
     g_string_append(rep, "\n");
     qemu_plugin_outs(rep->str);
 }
@@ -707,6 +817,9 @@ static void plugin_exit(void *p)
 
     if (use_l2) {
         caches_free(l2_ucaches);
+    }
+    if (use_l3) {
+        caches_free(l3_ucaches);
         g_free(l2_ucache_locks);
     }
 
@@ -797,6 +910,25 @@ int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info,
                 fprintf(stderr, "boolean argument parsing failed: %s\n", opt);
                 return -1;
             }
+        } else if (g_strcmp0(tokens[0], "l3cachesize") == 0) {
+            use_l3 = true;
+            l3_cachesize = STRTOLL(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "l3blksize") == 0) {
+            use_l3 = true;
+            l3_blksize = STRTOLL(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "l3assoc") == 0) {
+            use_l3 = true;
+            l3_assoc = STRTOLL(tokens[1]);
+        } else if (g_strcmp0(tokens[0], "l3") == 0) {
+            if (!qemu_plugin_bool_parse(tokens[0], tokens[1], &use_l3)) {
+                fprintf(stderr, "boolean argument parsing failed: %s\n", opt);
+                return -1;
+            }
+        } else if (g_strcmp0(tokens[0], "wstream") == 0) {
+            if (!qemu_plugin_bool_parse(tokens[0], tokens[1], &use_wstream)) {
+                fprintf(stderr, "boolean argument parsing failed: %s\n", opt);
+                return -1;
+            }
         } else if (g_strcmp0(tokens[0], "evict") == 0) {
             if (g_strcmp0(tokens[1], "rand") == 0) {
                 policy = RAND;
@@ -844,6 +976,18 @@ int qemu_plugin_install(qemu_plugin_id_t id, const qemu_info_t *info,
     l1_icache_locks = g_new0(GMutex, cores);
     l2_ucache_locks = use_l2 ? g_new0(GMutex, cores) : NULL;
 
+    if (use_l3) {
+        if (bad_cache_params(l3_blksize, l3_assoc, l3_cachesize)) {
+            fprintf(stderr, "L3 cache cannot be constructed from given parameters\n");
+            return -1;
+        }
+        l3_ucaches = caches_init(l3_blksize, l3_assoc, l3_cachesize);
+        l3_ucache_locks = g_new0(GMutex, cores);
+    }
+    ws_prev_line = g_new0(uint64_t, cores);
+    ws_streak = g_new0(int, cores);
+    ws_last_wline = g_new0(uint64_t, cores);
+
     qemu_plugin_register_vcpu_tb_trans_cb(id, vcpu_tb_trans, NULL);
     qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
 
